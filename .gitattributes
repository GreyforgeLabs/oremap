# Normalize line endings
* text=auto

# Explicit text files
*.md text diff=markdown
*.txt text
*.rs text diff=rust
*.json text
*.yml text
*.yaml text
*.toml text
*.sh text eol=lf
tests/golden/*.txt text eol=lf
Cargo.lock text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
*.webp binary
